# Knapsack Optimization Pipeline - Configuration Example
# Copy this to .env and modify as needed (if using python-dotenv)
# Current implementation uses config.py instead

# Project Directories
INPUT_DIR=/home/locode/Personale/QML/pyhtonTest/Input
OUTPUT_BASE_DIR=/home/locode/Personale/QML/pyhtonTest

# Optimization Parameters
QUBO_PENALTY_MULTIPLIER=2.0

# Qiskit Configuration
QISKIT_TIMEOUT_SECONDS=30
QISKIT_MAX_INSTANCE_SIZE=10

# Dimod Configuration
DIMOD_TIMEOUT_SECONDS=30
DIMOD_SKIP_LARGE_INSTANCES=true
DIMOD_LARGE_INSTANCE_THRESHOLD=10000
DIMOD_NUM_READS=100
DIMOD_NUM_RUNS=10

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# Error Handling
CONTINUE_ON_ERROR=true
DETAILED_ERROR_LOGS=true

# Performance
ENABLE_GARBAGE_COLLECTION=true
PARALLEL_PROCESSING=false
MAX_WORKERS=4

# Development
DEBUG_MODE=false
SKIP_LARGE_INSTANCES=true
